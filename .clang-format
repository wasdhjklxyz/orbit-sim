BasedOnStyle: LLVM
IncludeBlocks: Regroup
SortIncludes: CaseSensitive
# Main header is Priority 0 (automatic). Then: local, project, third-party, std.
IncludeCategories:
  - Regex: '^<gsb/'
    Priority: 2
  - Regex: '^<(SDL3|GLES3|glm|emscripten)[/.]'
    Priority: 3
  - Regex: '^<'
    Priority: 4
  - Regex: '.*'
    Priority: 1
