{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "build/${presetName}",
      "cacheVariables": {
        "GSB_BUILD_APP": "ON",
        "GSB_ENABLE_TESTING": "OFF"
      }
    },
    {
      "name": "em",
      "hidden": true,
      "inherits": "base",
      "toolchainFile": "$env{EM_TOOLCHAIN}",
      "cacheVariables": {
        "CMAKE_FIND_ROOT_PATH": "$env{SDL3_WASM_ROOT}",
        "FETCHCONTENT_SOURCE_DIR_GLM": "$env{glm_SRC}"
      }
    },
    {
      "name": "debug",
      "inherits": "em",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "inherits": "em",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "native",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SDL3_ROOT": "$env{SDL3_NATIVE_ROOT}"
      }
    },
    {
      "name": "native-test",
      "inherits": "native",
      "cacheVariables": {
        "GSB_ENABLE_TESTING": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "native", "configurePreset": "native" },
    { "name": "native-test", "configurePreset": "native-test" }
  ],
  "testPresets": [
    {
      "name": "native-test",
      "configurePreset": "native-test",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
